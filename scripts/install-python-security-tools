#!/usr/bin/env bash
# Keep Ubuntu's ABI; install the reproducible local pip security rebuild and seeds.
set -euo pipefail
expected=26.2.2+pasturestack.1
pip_wheel=/opt/python-security/pip-$expected-py3-none-any.whl
certifi_wheel=/opt/python-security/certifi-2026.10.19-py3-none-any.whl
test -s "$pip_wheel"
printf '%s  %s\n' be5f63d537bbe611dc422fabb6740a44b5997888b592888df5091727f023802a "$pip_wheel" | sha256sum -c -
test -s "$certifi_wheel"
if dpkg-query -W -f='${db:Status-Status}' python3-pip 2>/dev/null | grep -qx installed; then
    apt-get purge -y python3-pip
fi
PYTHONPATH="$pip_wheel" python3 -m pip install --break-system-packages --no-index --no-deps "$pip_wheel" "$certifi_wheel"
install -d /usr/share/python-wheels
find /usr/share/python-wheels -maxdepth 1 -type f -name 'pip-*.whl' -delete
install -m 0644 "$pip_wheel" /usr/share/python-wheels/
python3 -c 'import pip, certifi, pip._vendor.certifi as c; assert pip.__version__ == "26.2.2+pasturestack.1"; assert certifi.__version__ == c.__version__ == "2026.10.19"'
python3 /opt/python-security/scripts/test-pip-overlay.py
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
if python3 -c 'import ensurepip' 2>/dev/null; then
    python3 -c 'import ensurepip; assert ensurepip.version() == "26.2.2+pasturestack.1"'
    python3 -m venv "$scratch/venv"
    ensurepip_status=$expected
else
    # Do not add an unused distro ensurepip package just to exercise a test.
    python3 -m venv --without-pip "$scratch/venv"
    PYTHONPATH="$pip_wheel" "$scratch/venv/bin/python" -m pip install --no-index --no-deps "$pip_wheel"
    ensurepip_status=not-installed
fi
"$scratch/venv/bin/python" /opt/python-security/scripts/test-pip-overlay.py
if [ -n "${PYTHON_SECURITY_VIRTUALENV_PYTHON:-}" ]; then
    "$PYTHON_SECURITY_VIRTUALENV_PYTHON" -m virtualenv --no-download --no-periodic-update --pip="$expected" --extra-search-dir=/usr/share/python-wheels "$scratch/virtualenv"
    "$scratch/virtualenv/bin/python" /opt/python-security/scripts/test-pip-overlay.py
fi
printf 'PYTHON_SECURITY_TOOLS_OK pip=%s certifi=2026.10.19 ensurepip=%s\n' "$expected" "$ensurepip_status"
