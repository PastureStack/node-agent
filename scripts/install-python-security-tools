#!/usr/bin/env bash
# Retain the Ubuntu Python ABI and refresh active installers and future venv seeds.
set -euo pipefail
pip_wheel=/opt/python-security/pip-26.2.2-py3-none-any.whl
certifi_wheel=/opt/python-security/certifi-2026.10.19-py3-none-any.whl
test -s "$pip_wheel"
test -s "$certifi_wheel"
if dpkg-query -W -f='${db:Status-Status}' python3-pip 2>/dev/null | grep -qx installed; then
    apt-get purge -y python3-pip
fi
PYTHONPATH="$pip_wheel" python3 -m pip install --break-system-packages --no-index --no-deps "$pip_wheel" "$certifi_wheel"
install -d /usr/share/python-wheels
find /usr/share/python-wheels -maxdepth 1 -type f -name 'pip-*.whl' -delete
install -m 0644 "$pip_wheel" /usr/share/python-wheels/
python3 -c 'import pip, certifi, pip._vendor.certifi as vendor; assert pip.__version__ == "26.2.2"; assert certifi.__version__ == "2026.10.19"; assert vendor.__version__ == "2026.10.19"'
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
python3 -m venv "$scratch/ensurepip"
"$scratch/ensurepip/bin/python" -c 'import pip, pip._vendor.certifi as c; assert pip.__version__ == "26.2.2"; assert c.__version__ == "2026.10.19"'
if [ -n "${PYTHON_SECURITY_VIRTUALENV_PYTHON:-}" ]; then
    "$PYTHON_SECURITY_VIRTUALENV_PYTHON" -m virtualenv --no-download --pip=26.2.2 --extra-search-dir=/usr/share/python-wheels "$scratch/virtualenv"
    "$scratch/virtualenv/bin/python" -c 'import pip, pip._vendor.certifi as c; assert pip.__version__ == "26.2.2"; assert c.__version__ == "2026.10.19"'
fi
printf 'PYTHON_SECURITY_TOOLS_OK pip=26.2.2 certifi=2026.10.19 ensurepip=26.2.2\n'
