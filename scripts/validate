#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo Running validation

echo Running: go vet
go vet -mod=vendor ./...

echo Running: gofmt check
unformatted=$(find . \
    -path './.git' -prune -o \
    -path './third_party' -prune -o \
    -path './vendor' -prune -o \
    -name '*.go' -type f -print0 \
    | xargs -0 gofmt -l)
if [ -n "$unformatted" ]; then
    printf '%s\n' "$unformatted" >&2
    exit 1
fi
